from building import *
Import('rtconfig')

src   = []
cwd   = GetCurrentDir()
group = []

path = []
path += [cwd]
path += [cwd + '/include']
path += [cwd + '/silk', cwd + '/celt', cwd + '/silk/fixed']
src += Glob('./celt/*.c')
src += Glob('./silk/*.c')
src += Glob('./silk/fixed/*.c')
src += Glob('./src/*.c')

SrcRemove(src, ['./src/opus_demo.c', './src/repacketizer_demo.c', './src/opus_compare.c', './celt/opus_custom_demo.c'])

if GetDepend(['BF0_ACPU']):
    SrcRemove(src, ['./src/opus_test.c'])

# The media player's audio decode thread only has an 8 KiB stack, while an
# Opus 120 ms frame needs more than 23 KiB for the outer multistream scratch
# buffer alone.  Use Opus' bounded pseudo-stack so temporary codec storage is
# provided by opus_alloc_scratch() and can live in the application's media
# memory pool instead of overflowing the RT-Thread stack.
CPPDEFINES = ['HAVE_LRINTF', 'NONTHREADSAFE_PSEUDOSTACK', 'OPUS_BUILD', 'FIXED_POINT', 'DISABLE_FLOAT_API']

#LOCAL_CCFLAGS = ' -Wno-error -Wno-#warnings -O3'
#LOCAL_CCFLAGS = ' -Wno-error -Wno-#warnings -Ofast'
# TODO:
if rtconfig.PLATFORM != 'gcc':
    LOCAL_CCFLAGS = ' -Wno-error -Wno-#warnings -Oz'
else:    
    LOCAL_CCFLAGS = ''

# add src and include to group.
#
group = DefineGroup('libopus', src, depend = ['PKG_LIB_OPUS'], CPPPATH = path, CPPDEFINES = CPPDEFINES, LOCAL_CCFLAGS = LOCAL_CCFLAGS)

Return('group')
